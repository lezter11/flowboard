{
  // Production Pages project (flowboard-app). Not deployed yet. Pages ignores custom
  // config paths, so copy this as wrangler.jsonc into a staging dir with out/ and functions/.
  // See docs/RELEASE_BETA.md. Once deployed with this file it becomes the project's
  // source of truth for bindings.
  "name": "flowboard-app",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-19",
  "services": [{ "binding": "API", "service": "flowboard-api" }]
}
