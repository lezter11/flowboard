{
  // Pages project for UAT only. Deploy from apps/web:
  //   npx wrangler pages deploy out --config wrangler.uat.jsonc --project-name flowboard-app-uat
  "name": "flowboard-app-uat",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-19",
  "services": [{ "binding": "API", "service": "flowboard-api-uat" }]
}
