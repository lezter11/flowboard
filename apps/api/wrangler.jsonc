{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flowboard-api",
  "main": "src/runtime/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "18f56141ecef4b7cb07ecd42c90b155f"
    }
  ],
  // Per-client-IP counters (see src/services/rate-limit.ts). Namespace ids are account-wide and
  // must not collide with another Worker's; UAT uses its own range below.
  "ratelimits": [
    { "name": "FB_RL_WRITES", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "FRONTEND_URL": "https://flowboard-app.pages.dev",
    "CORS_ORIGIN": "https://flowboard-app.pages.dev",
    "GOOGLE_REDIRECT_URI": "https://flowboard-app.pages.dev/api/v1/auth/google/callback"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Top level == production (deployed as flowboard-api). uat redefines every
  // non-inherited key (vars, hyperdrive, triggers) so it never shares prod data.
  "env": {
    "uat": {
      "name": "flowboard-api-uat",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "7a1e3a69f51e41b1a8c46e0be263b814" }],
      "ratelimits": [
        { "name": "FB_RL_WRITES", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": {
        "FRONTEND_URL": "https://flowboard-app-uat.pages.dev",
        "CORS_ORIGIN": "https://flowboard-app-uat.pages.dev",
        "GOOGLE_REDIRECT_URI": "https://flowboard-app-uat.pages.dev/api/v1/auth/google/callback",
        // Mail sender for the UAT beta. Brevo rewrites the domain to @brevosend.com (accepted for the
        // internal beta). Non-secret; the API key is the BREVO_API_KEY secret, never in this file.
        "APP_ORIGIN": "https://flowboard-app-uat.pages.dev",
        "MAIL_FROM_NAME": "Flowboard",
        "MAIL_FROM_EMAIL": "shubhamsinghlez@gmail.com"
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      // Private image bucket for UAT only (no public access, no r2.dev, no custom domain).
      // Production has no IMAGES binding yet, so image routes return 503 CONFIG_ERROR there.
      "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "flowboard-images-uat" }]
    }
  }
}
