{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flowboard-api",
  "main": "src/runtime/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "18f56141ecef4b7cb07ecd42c90b155f",
      "localConnectionString": "postgres://flowboard_harness:flowboard_local_only@127.0.0.1:55432/flowboard_harness"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://flowboard-app.pages.dev",
    "CORS_ORIGIN": "https://flowboard-app.pages.dev",
    "GOOGLE_REDIRECT_URI": "https://flowboard-app.pages.dev/api/v1/auth/google/callback"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Top level == production (deployed as flowboard-api). dev/uat redefine every
  // non-inherited key (vars, hyperdrive, triggers) so they never share prod data.
  "env": {
    "dev": {
      "name": "flowboard-api-dev",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_DEV_HYPERDRIVE_ID" }],
      "vars": {
        "FRONTEND_URL": "https://flowboard-app-dev.pages.dev",
        "CORS_ORIGIN": "https://flowboard-app-dev.pages.dev",
        "GOOGLE_REDIRECT_URI": "https://flowboard-app-dev.pages.dev/api/v1/auth/google/callback"
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    },
    "uat": {
      "name": "flowboard-api-uat",
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "7a1e3a69f51e41b1a8c46e0be263b814" }],
      "vars": {
        "FRONTEND_URL": "https://flowboard-app-uat.pages.dev",
        "CORS_ORIGIN": "https://flowboard-app-uat.pages.dev",
        "GOOGLE_REDIRECT_URI": "https://flowboard-app-uat.pages.dev/api/v1/auth/google/callback"
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
