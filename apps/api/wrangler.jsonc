{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flowboard-api",
  "main": "src/runtime/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "18f56141ecef4b7cb07ecd42c90b155f",
      "localConnectionString": "postgres://flowboard_harness:flowboard_local_only@127.0.0.1:55432/flowboard_harness"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://flowboard-app.pages.dev",
    "CORS_ORIGIN": "https://flowboard-app.pages.dev"
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
