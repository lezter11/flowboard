{
  "name": "@flowboard/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:node": "node --watch src/runtime/node.ts",
    "dev:worker": "WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist/worker",
    "test": "WRANGLER_SEND_METRICS=false node --test-concurrency=1 --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": { "wrangler": "4.152.0" }
}
