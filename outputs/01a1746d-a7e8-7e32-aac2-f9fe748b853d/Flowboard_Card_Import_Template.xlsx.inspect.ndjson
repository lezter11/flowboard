{"kind":"table","sheet":"Instructions","address":"A1:G28","rows":28,"cols":7,"values":[[null,null,null,null,null,null,null],["Flowboard Excel import",null,null,null,null,null,null],[null,null,null,null,null,null,null],["Before upload",null,null,null,null,null,null],["1","Fill the Cards sheet. It is intentionally blank; examples below are not imported.",null,null,null,null,null],["2","Keep the seven headers unchanged. One non-empty row creates one card. Maximum 200 rows per upload.",null,null,null,null,null],["3","Choose the destination project, board and default column in Flowboard, then upload and review the preview.",null,null,null,null,null],["4","Only an owner or project manager imports. Assignee emails must already belong to eligible project teammates.",null,null,null,null,null],["5","Use stable External IDs. Re-uploading the same IDs skips existing rows; changed values require review, not automatic updates.",null,null,null,null,null],["6","Use literal values, not formulas, macros, linked workbooks or embedded files. Attach images to cards after import.",null,null,null,null,null],["7","The template is usable now. Automatic upload/import is planned and has not yet been implemented.",null,null,null,null,null],[null,null,null,null,null,null,null],["Field","Required / default","How to fill it",null,null,null,null],["External ID","Required","Text such as OPS-001 or 000123. Keep it unchanged for the same source task.",null,null,null,null],["Title","Required","Plain text, 1–200 characters.",null,null,null,null],["Description","Optional","Plain text, up to 20,000 characters.",null,null,null,null],["Priority","Blank = none","none, low, medium, high or urgent. Use the dropdown in Cards.",null,null,null,null],["Due Date","Blank = no deadline","Use an actual Excel date displayed as yyyy-mm-dd, or strict YYYY-MM-DD text.",null,null,null,null],["Assignees","Blank = unassigned","Separate multiple eligible project emails with semicolons, for example sam@example.com;lee@example.com.",null,null,null,null],["Status","Blank = chosen default","Use the exact board column name. Unknown names must be corrected or explicitly mapped in preview.",null,null,null,null],[null,null,null,null,null,null,null],["Examples only — do not copy IDs or emails without changing them",null,null,null,null,null,null],[null,null,null,null,null,null,null],["External ID","Title","Description","Priority","Due Date","Assignees","Status"],["OPS-001","Review login screen","Check error and loading states.","high","2026-11-05T00:00:00.000Z","sam@example.com;lee@example.com","In progress"],["OPS-002","Write project welcome text","Explain how teammates join the project.","medium",null,"","Not started"],[null,null,null,null,null,null,null],["Blank optional cells are allowed. Completely blank rows are ignored. Do not include extra columns in Cards.",null,null,null,null,null,null]]}
