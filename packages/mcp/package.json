{
  "name": "@flowboard/mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "flowboard-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/finalize-build.mjs",
    "prepack": "npm run build",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:artifact": "node --test --test-concurrency=1 test/artifact.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
