  "findings": [
    {
      "id": "F-01",
      "severity": "high",
      "mandatory": true,
      "blocking": true,
      "disposition": "open",
      "description": "DELETE /comments/:commentId receipt replay checks only member role at comments route lines 271-279, while deleteComment requires manager when actor is not the author (adapter lines 597-604). A demoted former moderator can replay saved success.",
      "counterevidence": "Current project grant lock runs before receipt read and removed/viewer users are rejected. No test covers moderator demotion replay.",
      "fix": "Determine comment author/moderator replay authority inside transaction before returning receipt; add author and manager demotion regression cases."
    },
    {
      "id": "F-02",
      "severity": "high",
      "mandatory": true,
      "blocking": true,
      "disposition": "open",
      "description": "Card create loads boards.archived but does not check it; it does not resolve projects.archived. Card update/move and comment post also lack archive state checks. This conflicts with FEATURE_SPEC read-only archive semantics.",
      "counterevidence": "Normal active card state and current project write grant are validated; restore path has archive checks.",
      "fix": "Use a shared locked archive-context guard for all mutation paths and test archived project/board create, edit, move and comment."
    },
    {
      "id": "F-03",
      "severity": "high",
      "mandatory": true,
      "blocking": true,
      "disposition": "open",
      "description": "moveCard accepts (null,null) as position 1000 without verifying destination emptiness; with two neighbors it verifies membership but not adjacency/order. Equal rank collisions and noncanonical insertion are possible.",
      "counterevidence": "getPlacement computes canonical pairs; valid movement tests pass. Database index is not unique on (column_id,position).",
      "fix": "Lock destination order, verify canonical adjacent neighbors under current board version, reject malformed pairs, and test populated-column null pair, nonadjacent/inverted pair and parallel moves."
    },
    {
      "id": "F-04",
      "severity": "high",
      "mandatory": true,
      "blocking": true,
      "disposition": "open",
      "description": "Mounted boardsRoutes placement handler is dispatched before cardsRoutes. boards adapter checks board/column/access but never verifies movingCardId exists, is active or belongs to this board/project.",
      "counterevidence": "It verifies board and destination column and computes destination order from active cards.",
      "fix": "Resolve and authorize the moving card and validate same board/project active state before returning placement."
    },
    {
      "id": "F-05",
      "severity": "medium",
      "mandatory": true,
      "blocking": true,
      "disposition": "open",
      "description": "getBoardCards and searchProjectCards filter overdue only by due_date < CURRENT_DATE and do not exclude cards whose column category is done. FEATURE_SPEC defines overdue excluding done cards.",
      "counterevidence": "Date-only Gregorian validation and the remaining due-date filters are exercised.",
      "fix": "Join columns and include category <> done in overdue predicates; add PostgreSQL tests for completed overdue cards."
    },
    {
      "id": "F-06",
      "severity": "high",
      "mandatory": true,
      "blocking": true,
      "disposition": "open",
      "description": "POST /cards/:cardId/comments checks receipt and returns it before calling postComment, whose adapter rejects trashed cards. After trash, a retry receives stale 201 replay outcome instead of current CARD_IS_TRASHED behavior. Receipt body minimization avoids old comment text but does not meet lifecycle semantics.",
      "counterevidence": "Current project grant lock precedes replay and receipt stores only minimal outcome.",
      "fix": "Recheck card state under the replay transaction before returning a comment receipt; add trash-after-success replay regression."
    }
  ],
