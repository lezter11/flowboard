// Supplemental HUI01 acceptance. Reviewer-only test; never edits the held615-file target.
import fs from 'node:fs/promises';
import path from 'node:path';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import pg from 'pg';
import { Miniflare, convertV4MiniflareOptions } from 'miniflare';
import { unstable_generateASSETSBinding } from 'wrangler';
import { chromium, expect } from '@playwright/test';
import { createApp } from '../../../../apps/api/src/http/app.ts';
import { runMigrations } from '../../../../apps/api/src/adapters/migrations.ts';
import { createDevUserAndSession } from '../../../../apps/api/src/adapters/session.ts';
import { MemoryStorageDriver } from '../../../../apps/api/src/adapters/storage.ts';
import { SharpImageVerifier } from '../../../../apps/api/src/services/image-verifier-node.ts';

assert.equal(process.env.NODE_ENV, 'test');
const root = fileURLToPath(new URL('../../../../', import.meta.url));
const review = path.dirname(fileURLToPath(import.meta.url));
const sourceManifestPath = path.join(root, 'docs/reviews/HOSTED-MCP-20261104/independent-backend-review/final-preparation/runs/2026-11-04T13-19-13.421Z/source-before.json');
const artifactPath = path.join(review, 'runs/2026-11-04T13-20-38.271Z/stage');
const out = path.join(review, 'name-step-runs', new Date().toISOString().replaceAll(':', '-'));
await fs.mkdir(out, { recursive: true });
const origin = 'http://127.0.0.1:44954';
const callback = 'https://claude.ai/api/mcp/auth_callback';
const image = 'postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24';
const container = 'flowboard-independent-name-' + process.pid;
const schema = 'name_' + crypto.randomUUID().replaceAll('-', '');
const password = crypto.randomBytes(32).toString('hex');
const lifetime = new AbortController();
const sha = b => crypto.createHash('sha256').update(b).digest('hex');
const result = { kind: 'Supplemental actual Chrome + compiled Pages + real mounted Hono + fresh disposable PostgreSQL; synthetic session, no Google provider', command: 'NODE_ENV=test node docs/reviews/HOSTED-MCP-20261104/independent-ui-review/name-step-runtime.mjs', start: new Date().toISOString(), harnessSha256: sha(await fs.readFile(fileURLToPath(import.meta.url))), sourceManifest: path.relative(root, sourceManifestPath), image, container, schema, loopbackPort: null, webOrigin: origin, checks: [], network: [], unexpectedConsole: [], unexpectedOrigins: [], sourceBeforeMismatches: [], sourceAfterMismatches: [], cleanup: { browser: false, workerd: false, schema: false, container: false } };
const held = JSON.parse(await fs.readFile(sourceManifestPath, 'utf8')).files;
async function mismatches() { const bad = []; for (const [p,h] of Object.entries(held)) { if (sha(await fs.readFile(path.join(root,p))) !== h) bad.push(p); } return bad; }
function docker(args, required = true) { const r = spawnSync('docker', args, { encoding: 'utf8', env: { ...process.env, POSTGRES_PASSWORD: password } }); if (required && r.status !== 0) throw new Error('Own disposable Docker operation failed'); return r.stdout?.trim() ?? ''; }
const pause = ms => new Promise(r => setTimeout(r,ms));
let started = false, admin, pool, mf, browser;
const previousCursor = process.env.CURSOR_SECRET;
if (!previousCursor) process.env.CURSOR_SECRET = crypto.randomBytes(32).toString('base64url');
try {
  result.sourceBeforeMismatches = await mismatches(); assert.deepEqual(result.sourceBeforeMismatches, []);
  docker(['run','--detach','--rm','--name',container,'--publish','127.0.0.1::5432','--tmpfs','/var/lib/postgresql/data','--env','POSTGRES_USER=flowboard_harness','--env','POSTGRES_DB=flowboard_harness','--env','POSTGRES_PASSWORD',image]); started = true;
  const port = Number(docker(['port',container,'5432/tcp']).split(':').at(-1)); assert.ok(port && ![55432,55479,55931,55010].includes(port)); result.loopbackPort = port;
  const deadline = Date.now()+30_000;
  for (;;) { if (spawnSync('docker',['exec',container,'pg_isready','-U','flowboard_harness','-d','flowboard_harness'],{stdio:'ignore'}).status === 0) break; assert.ok(Date.now()<deadline); await pause(250); }
  admin = new pg.Pool({ connectionString: `postgresql://flowboard_harness:${password}@127.0.0.1:${port}/flowboard_harness`, max: 1 });
  for (;;) { try { await admin.query('SELECT 1'); break; } catch { assert.ok(Date.now()<deadline); await pause(250); } }
  await admin.query(`CREATE SCHEMA "${schema}"`);
  pool = new pg.Pool({ connectionString: `postgresql://flowboard_harness:${password}@127.0.0.1:${port}/flowboard_harness`, max: 4, options: `-c search_path=${schema}` });
  await runMigrations(pool);
  const actor = await createDevUserAndSession(`review.${crypto.randomUUID()}@example.invalid`, 'Review Teammate', pool);
  const app = createApp(async () => { await pool.query('SELECT 1'); }, { pool, mcpPublicOrigin: origin, storage: new MemoryStorageDriver(), imageVerifier: new SharpImageVerifier(), rateLimiter: () => ({ limit: async () => ({ success: true }) }), windowCounter: () => ({ consume: async () => ({ count: 1, retryAfterSeconds: 60 }) }) });
  const created = await app.request(origin+'/api/v1/projects',{method:'POST',headers:{cookie:`flowboard_session=${actor.session.id}`,origin,'content-type':'application/json','idempotency-key':crypto.randomUUID()},body:JSON.stringify({name:'Name continuity review project'})}); assert.equal(created.status,201); const project=(await created.json()).data;
  // Only this synthetic actor is made a first-time name-confirmation user.
  await pool.query('UPDATE users SET name_confirmed_at=NULL,first_name=NULL,last_name=NULL WHERE id=$1',[actor.user.id]);
  const bridge = async req => { const u=new URL(req.url); assert.equal(u.origin,origin); const init={method:req.method,headers:new Headers(req.headers),redirect:'manual'}; if(!['GET','HEAD'].includes(req.method)) init.body=await req.arrayBuffer(); return app.fetch(new Request(req.url,init)); };
  const logger = Object.fromEntries(['debug','info','log','warn','error'].map(k=>[k,()=>{}]));
  const assets=await unstable_generateASSETSBinding({directory:path.join(artifactPath,'out'),log:logger,signal:lifetime.signal});
  mf=new Miniflare(convertV4MiniflareOptions({host:'127.0.0.1',port:44954,workers:[{name:'review-name-step',modules:true,scriptPath:path.join(artifactPath,'worker/index.js'),compatibilityDate:'2026-10-19',serviceBindings:{API:bridge,ASSETS:assets},outboundService:async()=>new Response('External request refused',{status:599})}]})); await mf.ready;
  browser=await chromium.launch({headless:true,executablePath:process.env.FLOWBOARD_CHROME_EXECUTABLE??'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'}); result.browser=await browser.version();
  const context=await browser.newContext({viewport:{width:1000,height:900}});
  await context.addCookies([{name:'flowboard_session',value:actor.session.id,domain:'127.0.0.1',path:'/',httpOnly:true,sameSite:'Lax'}]);
  let callbackSeen=false, decisionCount=0;
  await context.route('**/*',async route=>{const u=new URL(route.request().url());if(u.origin===origin||['blob:','data:'].includes(u.protocol))return route.continue();if(u.origin==='https://claude.ai'&&u.pathname==='/api/mcp/auth_callback'){assert.ok(u.searchParams.get('code'));assert.equal(u.searchParams.get('iss'),origin);callbackSeen=true;return route.fulfill({contentType:'text/html',body:'<h1>Local callback intercepted</h1>'});}result.unexpectedOrigins.push(u.origin);return route.abort();});
  const page=await context.newPage();page.on('pageerror',e=>result.unexpectedConsole.push({kind:'pageerror',name:e.name}));page.on('console',m=>{if(['error','warning'].includes(m.type()))result.unexpectedConsole.push({kind:m.type(),message:m.text().slice(0,200)});});
  page.on('response',r=>{const u=new URL(r.url());if(u.origin===origin&&u.pathname.startsWith('/api/'))result.network.push({path:u.pathname.replace(/authorization-requests\/[^/]+/,'authorization-requests/:id'),method:r.request().method(),status:r.status()});});
  page.on('request',r=>{if(r.method()==='POST'&&new URL(r.url()).pathname.endsWith('/decision'))decisionCount++;});
  const registration=await context.request.post(origin+'/api/v1/mcp/oauth/register',{data:{client_name:'Synthetic name-step client',redirect_uris:[callback]}});assert.equal(registration.status(),201);const clientId=(await registration.json()).client_id;
  const verifier=crypto.randomBytes(48).toString('base64url');
  const query=new URLSearchParams({client_id:clientId,redirect_uri:callback,response_type:'code',resource:origin+'/api/v1/mcp',scope:'projects:read boards:read cards:read cards:create',code_challenge_method:'S256',code_challenge:crypto.createHash('sha256').update(verifier).digest('base64url')});
  const authorize=await context.request.get(origin+'/api/v1/mcp/oauth/authorize?'+query,{maxRedirects:0});assert.equal(authorize.status(),302);const pending=new URL(authorize.headers().location);assert.equal(pending.origin,origin);assert.equal(pending.pathname,'/connect');assert.match(pending.search,/^\?request=[A-Za-z0-9_-]{43}$/);
  await page.goto(pending.href,{waitUntil:'networkidle'});await expect(page.getByRole('heading',{name:'What should we call you?',exact:true})).toBeVisible();assert.equal(page.url(),pending.href);result.checks.push({name:'needsName opens actual NameStep while keeping exact pending consent URL',status:'pass'});
  await page.getByLabel('First name',{exact:true}).fill('Review');await page.getByLabel('Last name',{exact:true}).fill('Teammate');
  const saved=page.waitForResponse(r=>new URL(r.url()).pathname==='/api/v1/session/name'&&r.request().method()==='PATCH');await page.getByRole('button',{name:'Continue',exact:true}).click();assert.equal((await saved).status(),200);
  await expect(page.getByLabel('Choose one project',{exact:true})).toBeVisible();assert.equal(page.url(),pending.href);await expect(page.getByRole('button',{name:'Allow connection',exact:true})).toBeDisabled();
  assert.equal((await pool.query('SELECT name_confirmed_at IS NOT NULL AS confirmed FROM users WHERE id=$1',[actor.user.id])).rows[0].confirmed,true);result.checks.push({name:'real name PATCH commits and session refresh resumes same consent without automatic approval',status:'pass'});
  await page.screenshot({path:path.join(out,'after-name-resumes-consent.png'),fullPage:true});
  await page.getByLabel('Choose one project',{exact:true}).selectOption(project.id);await page.getByRole('button',{name:'Allow connection',exact:true}).click();await expect(page.getByRole('heading',{name:'Local callback intercepted',exact:true})).toBeVisible();assert.equal(callbackSeen,true);assert.equal(decisionCount,1);assert.equal(Number((await pool.query('SELECT count(*) FROM mcp_oauth_connections WHERE client_id=$1 AND user_id=$2 AND project_id=$3',[clientId,actor.user.id,project.id])).rows[0].count),1);result.checks.push({name:'explicit project approval after NameStep produces exactly one real connection and safe intercepted callback',status:'pass'});
  assert.deepEqual(result.unexpectedConsole,[]);assert.deepEqual(result.unexpectedOrigins,[]);result.status='pass';
}catch(error){result.status='fail';result.failure={name:error?.name??'Error',message:String(error?.message??error).replace(/request=[A-Za-z0-9_-]+/g,'request=[redacted]').replace(/postgres(?:ql)?:\/\/\S+/g,'[redacted-database-url]').slice(0,700)};process.exitCode=1;}
finally{
 lifetime.abort();await browser?.close().catch(()=>{});result.cleanup.browser=true;await mf?.dispose().catch(()=>{});result.cleanup.workerd=true;
 await pool?.end().catch(()=>{});if(admin){await admin.query(`DROP SCHEMA IF EXISTS "${schema}" CASCADE`).then(()=>{result.cleanup.schema=true;}).catch(()=>{});await admin.end().catch(()=>{});}
 if(started){docker(['stop',container],false);docker(['rm','--force',container],false);result.cleanup.container=!docker(['ps','-a','--filter',`name=^/${container}$`,'--format','{{.Names}}'],false);}
 if(previousCursor===undefined)delete process.env.CURSOR_SECRET;
 result.sourceAfterMismatches=await mismatches().catch(()=>['manifest-read-failed']);if(result.sourceAfterMismatches.length){result.status='source-invalidated';process.exitCode=1;}
 result.end=new Date().toISOString();await fs.writeFile(path.join(out,'result.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({output:path.relative(root,out),status:result.status,checks:result.checks.length,sourceMismatches:result.sourceAfterMismatches.length,cleanup:result.cleanup}));
}
