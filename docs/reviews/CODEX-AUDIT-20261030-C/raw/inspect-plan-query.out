28- await explain('project-activity-feed',`SELECT a.id,a.workspace_id,a.project_id,a.card_id,a.actor_id,a.action,a.safe_changes,a.created_at FROM activity_log a WHERE a.project_id=$1 AND (a.visibility_scope='board' AND EXISTS(SELECT 1 FROM board_grants g WHERE g.board_id=a.board_id AND g.project_id=a.project_id AND g.workspace_id=a.workspace_id AND g.user_id=$2)) ORDER BY a.created_at DESC,a.id DESC LIMIT 51`,['plan_project','plan_member']);
29: const notif=`SELECT n.id,n.user_id,n.type,n.title,n.body,n.link,n.read,n.created_at FROM notifications n WHERE n.user_id=$1 AND EXISTS(SELECT 1 FROM projects p JOIN workspaces w ON w.id=p.workspace_id WHERE p.id=n.project_id AND p.workspace_id=n.workspace_id AND (w.owner_id=$1 OR (EXISTS(SELECT 1 FROM project_memberships pm WHERE pm.project_id=p.id AND pm.user_id=$1 AND pm.status='active') AND EXISTS(SELECT 1 FROM cards c JOIN boards b ON b.id=c.board_id AND b.project_id=c.project_id AND b.workspace_id=c.workspace_id JOIN board_grants g ON g.board_id=b.id AND g.project_id=b.project_id AND g.workspace_id=b.workspace_id AND g.user_id=$1 WHERE c.id=n.card_id AND c.project_id=n.project_id AND c.workspace_id=n.workspace_id AND c.state='active'))) AND ($2::boolean=false OR n.read=false) AND ($3::timestamptz IS NULL OR (n.created_at,n.id)<($3::timestamptz,$4::text)) ORDER BY n.created_at DESC,n.id DESC LIMIT $5`;
30- await explain('notifications-feed-all',notif,['plan_member',false,null,null,51]);
31- await explain('notifications-feed-unread',notif,['plan_member',true,null,null,51]);
