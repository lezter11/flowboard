name: flowboard-fnd01
services:
  postgres:
    image: postgres:17.11-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
    environment:
      POSTGRES_USER: flowboard_harness
      POSTGRES_PASSWORD: flowboard_local_only
      POSTGRES_DB: flowboard_harness
    ports:
      - "127.0.0.1:55432:5432"
    # Disposable synthetic database; stopping/removing it loses all data.
    tmpfs:
      - /var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U flowboard_harness -d flowboard_harness"]
      interval: 1s
      timeout: 3s
      retries: 30
    mem_limit: 256m
    cpus: 1

===== migration runner =====
import fs from 'node:fs/promises';
import fsSync from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import type pg from 'pg';
import { EMBEDDED_MIGRATIONS, type EmbeddedMigration } from './embedded-migrations.ts';

export interface MigrationRecord {
  version: string;
  name: string;
}

export interface RunMigrationsOptions {
  migrationsDir?: string;
}

export interface RunMigrationsResult {
  applied: MigrationRecord[];
}

function resolveDefaultMigrationsDir(): string | undefined {
  try {
    const currentDir = path.dirname(fileURLToPath(import.meta.url));
    const candidate1 = path.resolve(currentDir, '../../../../database/migrations');
    if (fsSync.existsSync(candidate1)) {
      return candidate1;
    }
    const candidate2 = path.resolve(process.cwd(), 'database/migrations');
    if (fsSync.existsSync(candidate2)) {
      return candidate2;
    }
  } catch {
    // In edge isolates, fileURLToPath or fsSync may not be supported
  }
  return undefined;
}

function isPool(target: pg.Pool | pg.ClientBase): target is pg.Pool {
  return typeof (target as pg.Pool).connect === 'function' && typeof (target as pg.Pool).totalCount === 'number';
}

async function executeMigrationsWithClient(
  client: pg.ClientBase,
  migrationsDir?: string
): Promise<RunMigrationsResult> {
  const applied: MigrationRecord[] = [];

  // Acquire an advisory lock to serialize concurrent migration attempts across instances.
  await client.query('SELECT pg_advisory_lock(hashtext($1))', ['flowboard_migrations']);

  try {
    // Ensure the schema_migrations tracking table exists.
    await client.query(`
      CREATE TABLE IF NOT EXISTS schema_migrations (
        version TEXT PRIMARY KEY,
        name TEXT NOT NULL,
        applied_at TIMESTAMPTZ NOT NULL
      );
    `);

    // Fetch already applied migrations.
    const existing = await client.query<{ version: string }>(
      'SELECT version FROM schema_migrations ORDER BY version ASC'
    );
    const appliedVersions = new Set(existing.rows.map((row) => row.version));

    // Discover migration items: from filesystem if available, otherwise from EMBEDDED_MIGRATIONS
    type MigrationItem = { version: string; name: string; sql: string };
    let migrationItems: MigrationItem[] = [];

    let hasFsDir = false;
    if (migrationsDir) {
      try {
        hasFsDir = fsSync.existsSync(migrationsDir);
      } catch {
        hasFsDir = false;
      }
    }

    if (hasFsDir && migrationsDir) {
      const dirEntries = await fs.readdir(migrationsDir, { withFileTypes: true });
      const migrationFiles = dirEntries
        .filter((entry) => entry.isFile() && /^(\d+)_([a-zA-Z0-9_\-]+)\.sql$/.test(entry.name))
        .map((entry) => entry.name)
        .sort((a, b) => a.localeCompare(b));

      for (const file of migrationFiles) {
        const match = /^(\d+)_([a-zA-Z0-9_\-]+)\.sql$/.exec(file);
        if (!match) continue;
        const version = match[1]!;
        const filePath = path.join(migrationsDir, file);
        const sqlContent = await fs.readFile(filePath, 'utf8');
        migrationItems.push({ version, name: file, sql: sqlContent });
      }
    } else {
      migrationItems = EMBEDDED_MIGRATIONS;
    }

    // Execute each pending migration within its own ACID transaction.
    for (const item of migrationItems) {
      if (appliedVersions.has(item.version)) {
        continue;
      }

      await client.query('BEGIN');
      try {
        await client.query(item.sql);
        await client.query(
          'INSERT INTO schema_migrations (version, name, applied_at) VALUES ($1, $2, NOW())',
          [item.version, item.name]
        );
        await client.query('COMMIT');
        applied.push({ version: item.version, name: item.name });
      } catch (error) {
        await client.query('ROLLBACK');
        throw error;
      }
    }

    return { applied };
  } finally {
    await client.query('SELECT pg_advisory_unlock(hashtext($1))', ['flowboard_migrations']);
  }
}

/**
 * Runs pending PostgreSQL migrations in database/migrations in version order.
 * Tracks applied migrations in `schema_migrations`.
 *
 * @param poolOrClient A pg.Pool or pg.ClientBase instance.
 * @param options Optional configuration including custom migrations directory.
 */
export async function runMigrations(
  poolOrClient: pg.Pool | pg.ClientBase,
  options?: RunMigrationsOptions
): Promise<RunMigrationsResult> {
  const migrationsDir = options?.migrationsDir ?? resolveDefaultMigrationsDir();

  if (isPool(poolOrClient)) {
    const client = await poolOrClient.connect();
    try {
      return await executeMigrationsWithClient(client, migrationsDir);
    } finally {
      client.release();
    }
  }

  return await executeMigrationsWithClient(poolOrClient, migrationsDir);
}

===== runtime database config =====
import { AsyncLocalStorage } from 'node:async_hooks';
import { Kysely, PostgresDialect, sql } from 'kysely';
import pg from 'pg';
import type { Context } from 'hono';
import { localDatabaseUrl } from '../runtime/local-config.ts';

// No product tables exist in FND-01. Typed domain tables arrive in FND-03.
export type HarnessDatabase = Kysely<Record<string, never>>;

let globalPool: pg.Pool | null = null;
export const poolStorage = new AsyncLocalStorage<pg.Pool>();

export function createPool(connectionString: string, maxConnections = 4): pg.Pool {
  const isLocal = connectionString.includes('127.0.0.1') || connectionString.includes('localhost');
  const pool = new pg.Pool({
    connectionString,
    max: maxConnections,
    connectionTimeoutMillis: isLocal ? 2_000 : 10_000,
    idleTimeoutMillis: 10_000,
    statement_timeout: isLocal ? 3_000 : 15_000,
    query_timeout: isLocal ? 4_000 : 15_000,
    application_name: 'flowboard-api',
  });
  pool.on('error', () => console.error('Idle PostgreSQL connection failed'));
  return pool;
}

export function getPool(target?: pg.Pool | pg.ClientBase | Context | string): pg.Pool {
  if (target && typeof target === 'object') {
    if ('query' in target && typeof (target as { query: unknown }).query === 'function') {
      return target as pg.Pool;
    }
    if ('get' in target && typeof (target as { get: unknown }).get === 'function') {
      const contextPool = (target as Context).get('pool') as pg.Pool | undefined;
      if (contextPool) return contextPool;
    }
  }
  const contextPool = poolStorage.getStore();
  if (contextPool) return contextPool;
  if (globalPool) return globalPool;
  const connStr = localDatabaseUrl(typeof target === 'string' ? target : process.env['DATABASE_URL']);
  globalPool = createPool(connStr, 4);
  return globalPool;
}

export function setGlobalPool(pool: pg.Pool | null): void {
  globalPool = pool;
}

export async function closePool(): Promise<void> {
  if (globalPool) {
    await globalPool.end();
    globalPool = null;
  }
}

export function createDatabase(connectionString: string, maxConnections: number): HarnessDatabase {
  const pool = new pg.Pool({
    connectionString,
    max: maxConnections,
    connectionTimeoutMillis: 2_000,
    idleTimeoutMillis: 5_000,
    statement_timeout: 3_000,
    query_timeout: 4_000,
    application_name: 'flowboard-fnd01',
  });
  // An idle connection error must not crash the local process or log its URL.
  pool.on('error', () => console.error('Idle PostgreSQL connection failed'));
  return new Kysely({ dialect: new PostgresDialect({ pool }) });
}

export async function queryDatabase(db: HarnessDatabase | pg.Pool | pg.ClientBase): Promise<void> {
  if ('query' in db && typeof db.query === 'function') {
    const result = await db.query<{ value: number }>('select 1::integer as value');
    if (result.rows[0]?.value !== 1) throw new Error('Unexpected database probe result');
    return;
  }
  const result = await sql<{ value: number }>`select ${1}::integer as value`.execute(db as HarnessDatabase);
  if (result.rows[0]?.value !== 1) throw new Error('Unexpected database probe result');
}
export const LOCAL_DATABASE_URL =
  'postgres://flowboard_harness:flowboard_local_only@127.0.0.1:55432/flowboard_harness';

// The foundation harness is intentionally limited to its disposable local DB during local tests.
// In production or when ALLOW_REMOTE_DB is set, valid postgres connection strings are permitted.
export function localDatabaseUrl(value = LOCAL_DATABASE_URL): string {
  const url = new URL(value);
  if (!['postgres:', 'postgresql:'].includes(url.protocol)) {
    throw new Error('Database connection URL must use postgres: or postgresql: protocol');
  }

  const isRemoteAllowed =
    process.env['NODE_ENV'] === 'production' ||
    process.env['ALLOW_REMOTE_DB'] === 'true' ||
    Boolean(process.env['FLY_APP_NAME'] || process.env['RAILWAY_ENVIRONMENT']);

  if (isRemoteAllowed) {
    return value;
  }

  if (!['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)
    || url.pathname !== '/flowboard_harness'
    || url.username !== 'flowboard_harness'
    || url.search !== '') {
    throw new Error('FND-01 requires the local flowboard_harness database and user');
  }
  return value;
}
