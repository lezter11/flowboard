===== project overview =====
import type pg from 'pg';
import type { ProjectOverview } from '@flowboard/contracts';
import { HttpError } from '../http/errors.ts';
import { getWorkspaceToday } from './boards.ts';

/**
 * GET /projects/:pid/overview: real counts for a project's dashboard.
 *
 * Who may read: the workspace owner, or any active project member (manager, member or viewer).
 * Which boards count: only boards the caller can read. The workspace owner reads every board in
 * the project. Anyone else reads a board only with an explicit board grant. The rule is written
 * once, in the `readable` CTE below, and every aggregate joins to it. Archived boards are left out
 * for everyone, matching the board list.
 *
 * Privacy: an unreadable board contributes nothing, not even to a total, so its name, id and card
 * counts never reach the response. Nothing is estimated: each number is a COUNT over real rows.
 *
 * Definitions (same as the board snapshot):
 *   - open: the card's column is not in the 'done' category;
 *   - overdue: open, with a due date before the workspace's today;
 *   - due soon: open, due from today to seven days later, inclusive;
 *   - unassigned open: open with no assignee.
 *
 * Recent activity: board-scoped rows on readable boards, plus project-scope rows (member, invitation,
 * brief and links events) for the owner and managers only (B-6). Members and viewers never see
 * project rows. Unscoped legacy rows are never shown. Token and invitee email are never logged, so
 * they cannot appear here.
 *
 * All reads run in one REPEATABLE READ, READ ONLY transaction, so the numbers describe one moment.
 */

const READABLE_BOARDS = `
  readable AS (
    SELECT b.id
    FROM boards b
    JOIN workspaces w ON w.id = b.workspace_id
    WHERE b.project_id = $1
      AND b.archived = FALSE
      AND (
        w.owner_id = $2
        OR EXISTS (
          SELECT 1 FROM board_grants g
          WHERE g.board_id = b.id AND g.project_id = b.project_id AND g.user_id = $2
        )
      )
  )`;

export async function getProjectOverview(
  pool: pg.Pool,
  projectId: string,
  actorId: string,
): Promise<ProjectOverview> {
  const client = await pool.connect();
  try {
    await client.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');

    // 1. Project access: the workspace owner or an active member. Anyone else gets 404.
    const ctx = await client.query<{ owner_id: string; timezone: string; role: string | null }>(
      `SELECT w.owner_id, w.timezone, pm.role
       FROM projects p
       JOIN workspaces w ON w.id = p.workspace_id
       LEFT JOIN project_memberships pm
         ON pm.project_id = p.id AND pm.user_id = $2 AND pm.status = 'active'
       WHERE p.id = $1`,
      [projectId, actorId],
    );
    const row = ctx.rows[0];
    if (!row || (row.owner_id !== actorId && !row.role)) {
      throw HttpError.notFound('Project not found.', 'NOT_FOUND');
    }
    const today = getWorkspaceToday(row.timezone);

    // 2. How many boards the caller can read. This is the caller's own view, not a leak.
    const boardCount = await client.query<{ n: string }>(
      `WITH ${READABLE_BOARDS} SELECT COUNT(*)::text AS n FROM readable`,
      [projectId, actorId],
    );

    // 3. Card counts per column category, plus overdue, due soon and unassigned, in one pass.
    const cardRows = await client.query<{
      category: 'todo' | 'active' | 'done';
      active: string;
      overdue: string;
      due_soon: string;
      unassigned_open: string;
    }>(
      `WITH ${READABLE_BOARDS}
       SELECT col.category,
              COUNT(*)::text AS active,
              COUNT(*) FILTER (WHERE c.due_date < $3::date AND col.category <> 'done')::text AS overdue,
              COUNT(*) FILTER (
                WHERE c.due_date >= $3::date AND c.due_date <= ($3::date + 7) AND col.category <> 'done'
              )::text AS due_soon,
              COUNT(*) FILTER (
                WHERE col.category <> 'done'
                  AND NOT EXISTS (SELECT 1 FROM card_assignees ca WHERE ca.card_id = c.id)
              )::text AS unassigned_open
       FROM cards c
       JOIN readable r ON r.id = c.board_id
       JOIN columns col ON col.id = c.column_id
       WHERE c.project_id = $1 AND c.state = 'active'
       GROUP BY col.category`,
      [projectId, actorId, today],
    );

    const byCategory = { todo: 0, active: 0, done: 0 };
    let active = 0;
    let overdue = 0;
    let dueSoon = 0;
    let unassignedOpen = 0;
    for (const r of cardRows.rows) {
      byCategory[r.category] = Number(r.active);
      active += Number(r.active);
      overdue += Number(r.overdue);
      dueSoon += Number(r.due_soon);
      unassignedOpen += Number(r.unassigned_open);
    }

    // 4. Open cards per assignee, on readable boards only. Bounded to 50 people.
    const assigneeRows = await client.query<{
      user_id: string;
      display_name: string;
      avatar_url: string | null;
      open_count: string;
    }>(
      `WITH ${READABLE_BOARDS}
       SELECT u.id AS user_id, u.display_name, u.avatar_url, COUNT(*)::text AS open_count
       FROM card_assignees ca
       JOIN cards c ON c.id = ca.card_id AND c.state = 'active' AND c.project_id = $1
       JOIN readable r ON r.id = c.board_id
       JOIN columns col ON col.id = c.column_id AND col.category <> 'done'
       JOIN users u ON u.id = ca.user_id
       GROUP BY u.id, u.display_name, u.avatar_url
       ORDER BY COUNT(*) DESC, u.id ASC
       LIMIT 50`,
      [projectId, actorId],
    );

    // 5. The last 10 activity rows: board rows on readable boards, plus project-scope rows (member,
    // invitation, brief and links events) for the owner and managers only. Members and viewers never
    // get project rows. One query; the project-row branch is a flag computed from the access check.
    const canSeeProjectRows = row.owner_id === actorId || row.role === 'manager';
    const activityRows = await client.query<{
      id: string;
      action: string;
      card_id: string | null;
      created_at: Date;
      actor_id: string;
      actor_name: string;
    }>(
      `WITH ${READABLE_BOARDS}
       SELECT a.id, a.action, a.card_id, a.created_at, a.actor_id, u.display_name AS actor_name
       FROM activity_log a
       JOIN users u ON u.id = a.actor_id
       WHERE a.project_id = $1
         AND (
           (a.visibility_scope = 'board' AND a.board_id IN (SELECT id FROM readable))
           OR (a.visibility_scope = 'project' AND $3::boolean)
         )
       ORDER BY a.created_at DESC, a.id DESC
       LIMIT 10`,
      [projectId, actorId, canSeeProjectRows],
    );

    await client.query('COMMIT');

    return {
      projectId,
      asOfDate: today,
      readableBoardCount: Number(boardCount.rows[0]?.n ?? 0),
      cards: {
        active,
        byCategory,
        overdue,
        dueSoon,
        unassignedOpen,
      },
      assignees: assigneeRows.rows.map((r) => ({
        userId: r.user_id,
        displayName: r.display_name,
        avatarUrl: r.avatar_url,
        openCount: Number(r.open_count),
      })),
      recentActivity: activityRows.rows.map((r) => ({
        id: r.id,
        action: r.action,
        cardId: r.card_id,
        createdAt: new Date(r.created_at).toISOString(),
        actor: { id: r.actor_id, displayName: r.actor_name },
      })),
    };
  } catch (err) {
    await client.query('ROLLBACK').catch(() => {});
    throw err;
  } finally {
    client.release();
  }
}

===== boards snapshot/list query blocks =====
export async function getBoardSnapshot(
  pool: pg.Pool,
  boardId: string,
  actorId: string,
  query?: BoardSnapshotQuery,
): Promise<BoardSnapshotData> {
  const client = await pool.connect();
  try {
    await client.query('BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ');
    // Acquire authorization locks before reading private board data. A plain
    // SELECT inside a repeatable-read snapshot could retain a revoked grant.
    await lockBoardAccess(client, boardId, actorId);

    // 1. Fetch board and workspace details
    const bRes = await client.query<{
      id: string;
      workspace_id: string;
      project_id: string;
      name: string;
      structure_version: number;
      snapshot_version: number;
      archived: boolean;
      created_at: Date;
      updated_at: Date;
      timezone: string;
      description: string | null;
    }>(
      `SELECT b.id, b.workspace_id, b.project_id, b.name, b.description,
              b.structure_version, b.snapshot_version, b.archived,
              b.created_at, b.updated_at, w.timezone
       FROM boards b
       JOIN workspaces w ON w.id = b.workspace_id
       WHERE b.id = $1`,
      [boardId],
    );

    if (bRes.rows.length === 0 || !bRes.rows[0]) {
      throw HttpError.notFound('Board not found.', 'NOT_FOUND');
    }

    const bRow = bRes.rows[0];

    const asOfDate = getWorkspaceToday(bRow.timezone);
    const cardLimit = Math.max(1, Math.min(query?.cardLimitPerColumn ?? 10, 15));

    // 3. Fetch columns ordered by position ASC
    const colsRes = await client.query<{
      id: string;
      board_id: string;
      name: string;
      category: 'todo' | 'active' | 'done';
      color: string;
      tone: ColumnTone | null;
      position: number;
    }>(
      `SELECT id, board_id, name, category, color, tone, position
       FROM columns
       WHERE board_id = $1
       ORDER BY position ASC`,
      [boardId],
    );

    const columnsList = colsRes.rows;

    // 4. Query active counts per column (ignoring filters, excluding trash)
    const activeCountsRes = await client.query<{ column_id: string; count: string }>(
      `SELECT col.id AS column_id, COUNT(c.id)::text AS count
       FROM columns col
       LEFT JOIN cards c ON c.column_id = col.id AND c.state = 'active'
       WHERE col.board_id = $1
       GROUP BY col.id`,
      [boardId],
    );
    const activeCountMap = new Map<string, number>();
    for (const r of activeCountsRes.rows) {
      activeCountMap.set(r.column_id, parseInt(r.count, 10));
    }

    // 5. Query matching counts per column (applying all filters)
    const filterClauses = buildCardFilterClauses(
      {
        titleQuery: query?.titleQuery,
        priority: query?.priority,
        assigneeId: query?.assigneeId,
        due: query?.due,
      },
      asOfDate,
      2,
    );

    const matchingCountsRes = await client.query<{ column_id: string; count: string }>(
      `SELECT col.id AS column_id, COUNT(c.id)::text AS count
       FROM columns col
       LEFT JOIN cards c ON c.column_id = col.id AND c.state = 'active'
       ${filterClauses.sql}
       WHERE col.board_id = $1
       GROUP BY col.id`,
      [boardId, ...filterClauses.params],
    );
    const matchingCountMap = new Map<string, number>();
    for (const r of matchingCountsRes.rows) {
      matchingCountMap.set(r.column_id, parseInt(r.count, 10));
    }

    // 5b. Board-wide due counters (ignore filters; same overdue rule as the due filter, done columns excluded).
    const dueCountsRes = await client.query<{ overdue: string; due_soon: string }>(
      `SELECT
         COUNT(*) FILTER (WHERE c.due_date < $2::date)::text AS overdue,
         COUNT(*) FILTER (WHERE c.due_date >= $2::date AND c.due_date <= ($2::date + 7))::text AS due_soon
       FROM cards c
       JOIN columns col ON col.id = c.column_id
       WHERE c.board_id = $1 AND c.state = 'active' AND c.due_date IS NOT NULL AND col.category <> 'done'`,
      [boardId, asOfDate],
    );
    const dueCounts = {
      overdue: Number(dueCountsRes.rows[0]?.overdue ?? 0),
      dueSoon: Number(dueCountsRes.rows[0]?.due_soon ?? 0),
    };

    // 6. Query cards per column up to cardLimit + 1
    const cardsParamStart = 2 + filterClauses.params.length;
    const cardsQueryRes = await client.query<{
      id: string;
      board_id: string;
      column_id: string;
      title: string;
      priority: Priority;
      due_date: string | null;
      position: string;
      version: number;
      created_at: Date;
      updated_at: Date;
      comment_count: number;
      image_count: number;
      assignee_ids: string[];
      card_key: string;
      description_excerpt: string;
      row_num: string;
    }>(
      `WITH filtered_cards AS (
         SELECT
           c.id,
           c.board_id,
           c.column_id,
           c.title,
           p.key_prefix || '-' || c.card_number::text AS card_key,
           LEFT(BTRIM(REGEXP_REPLACE(REGEXP_REPLACE(COALESCE(c.description, ''), '<[^>]*>|[#*_\`~>\\[\\]]', ' ', 'g'), '\\s+', ' ', 'g')), 160) AS description_excerpt,
           c.priority,
           TO_CHAR(c.due_date, 'YYYY-MM-DD') AS due_date,
           c.position,
           c.version,
           c.created_at,
           c.updated_at,
           COALESCE(comm.comment_count, 0)::int AS comment_count,
           COALESCE(img.image_count, 0)::int AS image_count,
           COALESCE(assignees.user_ids, ARRAY[]::text[]) AS assignee_ids,
           ROW_NUMBER() OVER (PARTITION BY c.column_id ORDER BY c.position ASC, c.id ASC) AS row_num
         FROM cards c
         JOIN columns col ON col.id = c.column_id
         JOIN projects p ON p.id = c.project_id
         LEFT JOIN (
export async function listBoardCards(
  clientOrPool: pg.Pool | pg.ClientBase,
  boardId: string,
  query: CardsQuery,
  actorId: string,
): Promise<CardListResponse> {
  const pool = clientOrPool ?? getPool();

  // 1. Verify board exists and actor has access
  const bRes = await pool.query<{
    id: string;
    project_id: string;
    workspace_id: string;
    structure_version: number;
    snapshot_version: number;
    timezone: string;
  }>(
    `SELECT b.id, b.project_id, b.workspace_id, b.structure_version, b.snapshot_version, w.timezone
     FROM boards b
     JOIN workspaces w ON w.id = b.workspace_id
     WHERE b.id = $1`,
    [boardId],
  );

  if (bRes.rows.length === 0 || !bRes.rows[0]) {
    throw HttpError.notFound('Board not found.', 'NOT_FOUND');
  }

  const bRow = bRes.rows[0];

  await requireBoardRead(pool, boardId, bRow.project_id, actorId);

  const asOfDate = getWorkspaceToday(bRow.timezone);
  const limit = Math.max(1, Math.min(query.limit ?? 50, 100));

  const currentFilterHash = computeCardFilterHash({
    columnId: query.columnId,
    query: query.query,
    priority: query.priority,
    assigneeId: query.assigneeId,
    due: query.due,
    asOfDate,
  });

  const filterClauses = buildCardFilterClauses(
    {
      columnId: query.columnId,
      titleQuery: query.query,
      priority: query.priority,
      assigneeId: query.assigneeId,
      due: query.due,
    },
    asOfDate,
    2,
  );

  const queryParams: unknown[] = [boardId, ...filterClauses.params];

  // 2. Decode cursor
  let cursorCondition = '';
  if (query.cursor) {
    const cursorPayload = decodeCardCursor(query.cursor);
    if (
      !cursorPayload ||
      cursorPayload.bId !== boardId ||
      cursorPayload.fH !== currentFilterHash ||
      cursorPayload.sV !== bRow.snapshot_version ||
      cursorPayload.oV !== bRow.structure_version
    ) {
      throw HttpError.conflict('Stale or malformed pagination cursor.', 'STALE_CURSOR');
    }

    const curPosIdx = queryParams.length + 1;
    const curIdIdx = queryParams.length + 2;
    cursorCondition = ` AND (c.position > $${curPosIdx} OR (c.position = $${curPosIdx} AND c.id > $${curIdIdx}))`;
    queryParams.push(cursorPayload.position, cursorPayload.id);
  }

  const limitParamIdx = queryParams.length + 1;
  queryParams.push(limit + 1);

  const sql = `
    SELECT
      c.id,
      c.board_id,
      c.column_id,
      c.title,
      c.priority,
      TO_CHAR(c.due_date, 'YYYY-MM-DD') AS due_date,
      c.position,
      c.version,
      c.created_at,
      c.updated_at,
      COALESCE(comm.comment_count, 0)::int AS comment_count,
      COALESCE(img.image_count, 0)::int AS image_count,
      COALESCE(assignees.user_ids, ARRAY[]::text[]) AS assignee_ids
    FROM cards c
    JOIN columns col ON col.id = c.column_id
    LEFT JOIN (
      SELECT card_id, COUNT(*)::int AS comment_count
      FROM comments
      WHERE deleted_at IS NULL
      GROUP BY card_id
    ) comm ON comm.card_id = c.id
    LEFT JOIN (
      SELECT card_id, COUNT(*)::int AS image_count
      FROM card_images
      GROUP BY card_id
    ) img ON img.card_id = c.id
    LEFT JOIN (
      SELECT card_id, ARRAY_AGG(user_id ORDER BY user_id ASC) AS user_ids
      FROM card_assignees
      GROUP BY card_id
    ) assignees ON assignees.card_id = c.id
    WHERE c.board_id = $1 AND c.state = 'active'
      ${filterClauses.sql}
      ${cursorCondition}
    ORDER BY c.position ASC, c.id ASC
    LIMIT $${limitParamIdx}
  `;

  const res = await pool.query<{
    id: string;
    board_id: string;
    column_id: string;
    title: string;
    priority: Priority;
    due_date: string | null;
    position: string;
    version: number;
    created_at: Date;
    updated_at: Date;
    comment_count: number;
    image_count: number;
    assignee_ids: string[];
  }>(sql, queryParams);

===== project/activity/notification indexes =====
